// Copy this file to Secrets.xcconfig and fill in local secrets.
//
//   cp Secrets.xcconfig.example Secrets.xcconfig
//
// Secrets.xcconfig is gitignored — never commit real keys.

GEMINI_API_KEY = YOUR_GEMINI_API_KEY_HERE

// Leave empty to use Simulator localhost (http://127.0.0.1:8000).
// After Railway deploy, set the public HTTPS URL, for example:
// BACKEND_BASE_URL = https://travel-ai-backend-production-xxxx.up.railway.app
BACKEND_BASE_URL =
