// Copy this file to Secrets.xcconfig and fill in local values.
//
//   cp Secrets.xcconfig.example Secrets.xcconfig
//
// Secrets.xcconfig is gitignored — never commit real secrets.
//
// Gemini API key lives only on the backend (.env / Railway Variables).
//
// Leave BACKEND_HOST empty for Simulator localhost (http://127.0.0.1:8000).
// For device / Railway testing put only the hostname:
// BACKEND_HOST = your-service.up.railway.app

BACKEND_HOST =
